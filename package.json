{
  "name": "dsh-web-mobile-fix",
  "version": "1.12.0",
  "description": "Mobile fixes for the DeepSeek Harness Web UI: layout overlay (settings panel, popups, sidebar, session header, tooltips) plus a touch terminal key panel (Esc/Tab, sticky Ctrl/Alt, arrows) on narrow (≤700px) screens. Pure client-side.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmugu/dsh-web-mobile-fix.git"
  },
  "homepage": "https://github.com/gmugu/dsh-web-mobile-fix",
  "bugs": {
    "url": "https://github.com/gmugu/dsh-web-mobile-fix/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mobile",
    "web-ui",
    "css",
    "terminal",
    "touch"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.0-rc.2"
  }
}